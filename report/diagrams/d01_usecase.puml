@startuml
!include _style.iuml
left to right direction
actor "End user /\nDeveloper" as U
actor "Application\n(SDK, IDE, agent)" as A
actor "Model author" as M
actor "Operator /\nsysadmin" as O
actor "ollama.com\nregistry" as R <<system>>
rectangle "Ollama" {
  usecase "Run / chat with\na model (CLI)" as UC1
  usecase "Call REST API\n(native, OpenAI-,\nAnthropic-compatible)" as UC2
  usecase "Generate\nembeddings" as UC3
  usecase "Pull model" as UC4
  usecase "Create model\nfrom Modelfile /\nGGUF / safetensors" as UC5
  usecase "Push model" as UC6
  usecase "List / show /\ncopy / delete" as UC7
  usecase "Configure server\n(OLLAMA_* env vars)" as UC8
  usecase "Schedule models\non GPUs / CPU" as UC9
}
U --> UC1
U --> UC7
A --> UC2
A --> UC3
M --> UC5
M --> UC6
O --> UC8
O --> UC4
UC1 ..> UC2 : <<include>>
UC2 ..> UC9 : <<include>>
UC3 ..> UC9 : <<include>>
UC1 ..> UC4 : <<extend>>\nif missing
UC4 --> R
UC6 --> R
@enduml
